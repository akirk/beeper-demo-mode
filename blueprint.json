{
	"$schema": "https://playground.wordpress.net/blueprint-schema.json",
	"meta": {
		"title": "Beeper Demo Mode",
		"description": "Anonymize names and images from the Beeper client",
		"author": "Alex Kirk"
	},
	"steps": [
		{
			"step": "installPlugin",
			"pluginData": {
